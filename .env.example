# ── Required: Databricks (AI features + live data) ────────────────────────────
# Used for the LLM (Prioritize tab) and optional live data refresh.
# Get access at https://databricks.com — free trial available.
DATABRICKS_HOST=https://dbc-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=your_databricks_personal_access_token

# ── Required for SQL Query tab only ──────────────────────────────────────────
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxx

# ── Optional: Databricks catalog/schema (defaults shown) ─────────────────────
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=geo_insight
